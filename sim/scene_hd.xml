<mujoco model="anymal_c scene hd">
  <include file="anymal_c_torque.xml"/>

  <visual>
    <headlight diffuse="0.45 0.45 0.45" ambient="0.32 0.32 0.34" specular="0.1 0.1 0.1"/>
    <rgba haze="0.16 0.24 0.33 1"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
    <quality shadowsize="8192" offsamples="8" numslices="56" numstacks="32"/>
    <map shadowclip="3" shadowscale="0.8" fogstart="8" fogend="30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.42 0.58" rgb2="0.02 0.04 0.07" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.22 0.30 0.39" rgb2="0.13 0.19 0.26"
      markrgb="0.72 0.76 0.80" width="600" height="600"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="6 6" reflectance="0.12" shininess="0.2"/>
  </asset>

  <worldbody>
    <light pos="1.2 -1.0 3.0" dir="-0.3 0.3 -1" directional="true" diffuse="0.75 0.75 0.72" specular="0.25 0.25 0.25" castshadow="true"/>
    <light pos="-2.0 2.0 2.4" dir="0.5 -0.5 -1" directional="true" diffuse="0.22 0.24 0.28" specular="0 0 0" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <camera name="track" pos="2.5 -2.5 1.6" xyaxes="0.707 0.707 0 -0.3 0.3 0.9"/>
  </worldbody>
</mujoco>
